package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// On-device LLM backend (LiteRT-LM) is optional and OFF by default. Enable it
// from the product makefile (e.g. device.mk):
//   $(call soong_config_set,aiphoneassistant,with_litertlm,true)
// and populate libs/ with tools/fetch-litertlm.sh (build.sh does this when
// WITH_LITERTLM=1). The fetch script also generates libs/litertlm/Android.bp,
// which defines the aiphone-litertlm-* modules referenced below.
soong_config_module_type {
    name: "aiphone_android_app",
    module_type: "android_app",
    config_namespace: "aiphoneassistant",
    bool_variables: ["with_litertlm", "with_npu"],
    properties: [
        "srcs",
        "static_libs",
        "use_embedded_native_libs",
        "jni_libs",
    ],
}

aiphone_android_app {
    name: "AIPhoneAssistant",

    srcs: ["src/**/*.java"],

    resource_dirs: ["res"],

    // Privileged system app
    privileged: true,

    // System signature - REQUIRED for signature-level permissions
    certificate: "platform",

    // Hidden framework APIs (IWindowManager.captureDisplay, InputManager.injectInputEvent)
    // are called directly; no reflection is used.
    platform_apis: true,

    optimize: {
        proguard_flags_files: ["proguard.flags"],
        shrink: true,
    },

    soong_config_variables: {
        with_litertlm: {
            srcs: ["src-litertlm/**/*.java"],
            static_libs: [
                "aiphone-litertlm-android",
                "aiphone-litertlm-deps",
            ],
            // Keep liblitertlm_jni.so inside the APK (uncompressed, page
            // aligned) so adb install -r updates carry it along. The optional
            // NPU dispatch/QNN libraries are NOT baked into the APK: they are
            // copied into /system_ext/lib64 by the product makefile (or into a
            // readable dir set via the "NPU Library Dir" setting) because they
            // come from the device's own QAIRT runtime.
            use_embedded_native_libs: true,
            // JNI lib is declared explicitly (libs/litertlm/Android.bp) so the
            // same prebuilt mechanism can carry the optional NPU libs.
            jni_libs: ["aiphone-litertlm-jni"],
        },
        // Optional Qualcomm NPU runtime (libLiteRtDispatch_Qualcomm.so +
        // libQnn* + HTP skel). Modules are generated by tools/fetch-npu-libs.sh
        // into libs/litertlm/Android.bp; enable from the product makefile with
        // $(call soong_config_set,aiphoneassistant,with_npu,true).
        with_npu: {
            // NPU libs must live in the real nativeLibraryDir: LiteRT loads the
            // dispatch library by absolute path, and the app linker namespace
            // only allows the app's own lib dirs (not /system_ext/lib64).
            use_embedded_native_libs: false,
            jni_libs: [
                "aiphone-npu-libLiteRtDispatch_Qualcomm",
                "aiphone-npu-libLiteRtCompilerPlugin_Qualcomm",
                "aiphone-npu-libQnnHtp",
                "aiphone-npu-libQnnSystem",
                "aiphone-npu-libQnnHtpV75Stub",
                "aiphone-npu-libQnnHtpPrepare",
                "aiphone-npu-libQnnHtpV75Skel",
            ],
        },
    },

    required: ["privapp-permissions-aiphoneassistant"],

    system_ext_specific: true,
}

// Privileged permissions XML file
prebuilt_etc {
    name: "privapp-permissions-aiphoneassistant",
    src: "privapp-permissions-aiphoneassistant.xml",
    system_ext_specific: true,
    sub_dir: "permissions",
}
